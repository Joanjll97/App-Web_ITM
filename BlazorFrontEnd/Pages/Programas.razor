@page "/Programas"

@using System.Net.Http.Json
@using BlazorFrontEnd.Services
@inject ApiService ApiService
@inject IJSRuntime JSRuntime

<h3>Consulta Programas</h3>

<div>
    <label>Código de la Programas:</label>
    <input @bind="consultaCodigo" />
    <button @onclick="ConsultarProgramas">Consultar</button>
    <button @onclick="ClearConsulta">Limpiar Consulta</button>
</div>

@if (ProgramasEncontrada)
{
    <div>
        <h4>Información del Programas</h4>
        <p><strong>Nombre:</strong> @consultaNombre</p>
        <p><strong>Tipo:</strong> @consultaTipo</p>
        <p><strong>Ciudad:</strong> @consultaCiudad</p>
        <p><strong>Nivel:</strong> @consultaNivel</p>
        <p><strong>Facultad:</strong> @consultaFacultad</p>
        <button @onclick="ModificarProgramasConsultada">Modificar</button>
        <button @onclick="EliminarProgramasConsultada">Eliminar</button>
    </div>
}
else if (!string.IsNullOrWhiteSpace(consultaCodigo))
{
    <p>No se encontró ninguna Programas con ese código.</p>
}

<h4>Historial de Consultas</h4>
<table class="table">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Nivel</th>
            <th>Ciudad</th>
            <th>Facultad</th>             
        </tr>
    </thead>
    <tbody>
        @if (!historialConsultas.Any())
        {
            <tr>
                <td colspan="4">No hay historial de consultas.</td>
            </tr>
        }
        else
        {
            foreach (var consulta in historialConsultas)
            {
                <tr>
                    <td>@consulta.Codigo</td>
                    <td>@consulta.Nombre</td>
                    <td>@consulta.Tipo</td>
                    <td>@consultaNivel</td>
                    <td>@consulta.Ciudad</td>
                    <td>@consultaFacultad</td>                      
                </tr>
            }
        }
    </tbody>
</table>

<!-- Botón para Añadir Nueva Programas -->
<button @onclick="ShowAddModal">Añadir Nuevo Programa</button>

<!-- Botones de Paginación -->
<div>
    <button @onclick="PreviousPage" disabled="@(!CanGoToPreviousPage)">Anterior</button>
    <button @onclick="NextPage" disabled="@(!CanGoToNextPage)">Siguiente</button>
</div>

<!-- Modal para Añadir/Modificar Programas -->
<div class="modal" style="@(isNewProgramas ? "display:none" : "display:block")">
    <div class="modal-content">
        <span class="close" @onclick="CloseModal">&times;</span>
        <h3>@(isNewProgramas ? "Añadir Programas" : "Modificar Programas")</h3>
        <label>Código:</label>
        <input @bind="codigo" />
        <label>Nombre:</label>
        <input @bind="nombre" />
        <label>Tipo:</label>
        <input @bind="tipo" />
        <label>Nivel:</label>
        <input @bind="nivel" />
        <label>Ciudad:</label>
        <input @bind="ciudad" />
        <label>Facultad:</label>
        <input @bind="facultad" />
        <button @onclick="SaveProgramas">@if (isNewProgramas) { <text>Añadir</text> } else { <text>Modificar</text> }</button>
        <button @onclick="ClearFields">Cancelar</button>
    </div>
</div>


<!-- Modal para Añadir/Modificar Programas -->
<div class="modal" style="@(isNewProgramas ? "display:none" : "display:block")">
    <div class="modal-content">
        <span class="close" @onclick="CloseModal">&times;</span>
        <h3>@(isNewProgramas ? "Añadir Programas" : "Modificar Programas")</h3>
        <label>Código:</label>
        <input @bind="codigo" />
        <label>Nombre:</label>
        <input @bind="nombre" />
        <label>Tipo:</label>
        <input @bind="tipo" />
        <label>Nivel:</label>
        <input @bind="nivel" />
        <label>Ciudad:</label>
        <input @bind="ciudad" />
        <label>Facultad:</label>
        <input @bind="facultad" />
        <button @onclick="SaveProgramas">@if (isNewProgramas) { <text>Añadir</text> } else { <text>Modificar</text> }</button>
        <button @onclick="ClearFields">Cancelar</button>
    </div>
</div>

@code {
    private List<Dictionary<string, object>> Programases = new();
    private bool isNewProgramas = true;
    private bool ProgramasEncontrada = false;

    private string codigo = string.Empty;
    private string nombre = string.Empty;
    private string tipo = string.Empty;
    private string nivel = string.Empty;
    private string ciudad = string.Empty;
    private string facultad = string.Empty;
    

    private string consultaCodigo = string.Empty;
    private string consultaNombre = string.Empty;
    private string consultaTipo = string.Empty;
    private string consultaNivel = string.Empty;
    private string consultaCiudad = string.Empty;
    private string consultaFacultad = string.Empty;
    
    

    private List<ConsultaHistorial> historialConsultas = new();
    private int currentPage = 1;
    private const int pageSize = 10; 
    private bool CanGoToPreviousPage => currentPage > 1;
    private bool CanGoToNextPage => Programases.Count == pageSize;

    protected override async Task OnInitializedAsync()
    {
        await LoadProgramases();
    }

    private async Task LoadProgramases()
    {
        try
        {
            Programases = await ApiService.GetDataAsync($"api/proyecto/programa?page={currentPage}&size={pageSize}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar Programas: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "Error al cargar Programas. Por favor, intente nuevamente.");
        }
    }
private async Task ConsultarProgramas()
{
    try
    {
        // Consulta los detalles del programa
        var resultado = await ApiService.GetDataAsync($"api/proyecto/programa/id/{consultaCodigo}");
        if (resultado.Any())
        {
            var programasConsultada = resultado.First();
            consultaNombre = programasConsultada["nombre"]?.ToString() ?? string.Empty;
            consultaTipo = programasConsultada["tipo"]?.ToString() ?? string.Empty;
            consultaNivel = programasConsultada["nivel"]?.ToString() ?? string.Empty;
            consultaCiudad = programasConsultada["ciudad"]?.ToString() ?? string.Empty;
            var facultadId = programasConsultada["facultad"]?.ToString(); // Obtener el ID de la facultad
            
            // Obtener el nombre de la facultad si el ID está disponible
            if (!string.IsNullOrWhiteSpace(facultadId))
            {
                var facultadResultado = await ApiService.GetDataAsync($"api/proyecto/facultad/id/{facultadId}");
                if (facultadResultado.Any())
                {
                    consultaFacultad = facultadResultado.First()["nombre"]?.ToString() ?? string.Empty; // Obtener el nombre de la facultad
                }
                else
                {
                    consultaFacultad = "Facultad no encontrada"; // Mensaje en caso de que no se encuentre la facultad
                }
            }
            else
            {
                consultaFacultad = "ID de facultad no disponible"; // Mensaje en caso de que no haya ID de facultad
            }

            ProgramasEncontrada = true;

            // Agregar a historial
            historialConsultas.Add(new ConsultaHistorial
            {
                Codigo = consultaCodigo,
                Nombre = consultaNombre,
                Tipo = consultaTipo,
                Ciudad = consultaCiudad,
                Nivel = consultaNivel,
                Facultad = consultaFacultad
            });
        }
        else
        {
            ClearConsulta();
            await JSRuntime.InvokeVoidAsync("alert", "No se encontró ninguna Programa con ese código.");
        }
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Error al consultar Programas: {ex.Message}");
        await JSRuntime.InvokeVoidAsync("alert", "Error al consultar los Programas. Por favor, intente nuevamente.");
    }
}

    private async Task SaveProgramas()
    {
        // Validación de campos
        if (string.IsNullOrWhiteSpace(codigo) || string.IsNullOrWhiteSpace(nombre) ||
            string.IsNullOrWhiteSpace(tipo) || string.IsNullOrWhiteSpace(ciudad))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Todos los campos son obligatorios.");
            return; // Salir si hay campos vacíos
        }

        try
        {
            // Capturar todos los registros en un solo diccionario
            var ProgramasData = new Dictionary<string, object>
            {
                { "nombre", nombre },
                { "tipo", tipo },
                { "nivel", nivel },
                { "ciudad", ciudad }
                
            };

            bool success;
            
            // Enviar todos los datos en una sola llamada a la API
            if (isNewProgramas)
            {
                success = await ApiService.AddEntityAsync("api/proyecto/programa/id", ProgramasData);
            }
            else
            {
                success = await ApiService.EditEntityAsync("api/proyecto/programa/id",codigo, ProgramasData);
            }

            if (success)
            {
                await LoadProgramases();
                ClearFields();
                await JSRuntime.InvokeVoidAsync("alert", "Se modifica de manera correcta la Programas.");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Error al guardar la Programas. Por favor, intente nuevamente.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar Programas: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "Error al guardar la Programas. Por favor, intente nuevamente.");
        }
    }

    private void CloseModal()
    {
        ClearFields();
    }

    private async Task ShowAddModal()
    {
        ClearFields();
        isNewProgramas = true; // Asegúrate de que el modal se abra en modo añadir
        await JSRuntime.InvokeVoidAsync("showModal", "addProgramasModal");
    }

    private async Task ModificarProgramasConsultada()
    {
        isNewProgramas = false;
        codigo = consultaCodigo;
        nombre = consultaNombre;
        tipo = consultaTipo;
        nivel = consultaNivel;
        ciudad = consultaCiudad;
        

        await JSRuntime.InvokeVoidAsync("showModal", "editProgramasModal");
    }

    private async Task EliminarProgramasConsultada()
    {
        if (string.IsNullOrWhiteSpace(consultaCodigo)) return;

        bool success = await ApiService.DeleteEntityAsync("api/proyecto/programa/id", consultaCodigo);
        if (success)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Programas eliminada con éxito.");
            await LoadProgramases();
            ClearFields();
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error al eliminar la Programas. Por favor, intente nuevamente.");
        }
    }

    private void ClearFields()
    {
        codigo = string.Empty;
        nombre = string.Empty;
        tipo = string.Empty;
        ciudad = string.Empty;
        nivel = string.Empty;
        isNewProgramas = true;
        ProgramasEncontrada = false;
    }

    private void ClearConsulta()
    {
        consultaCodigo = string.Empty;
        ClearFields();
    }

    private async Task NextPage()
    {
        currentPage++;
        await LoadProgramases();
    }

    private async Task PreviousPage()
    {
        if (CanGoToPreviousPage)
        {
            currentPage--;
            await LoadProgramases();
        }
    }

    public class ConsultaHistorial
    {
        public string Codigo { get; set; }
        public string Nombre { get; set; }
        public string Tipo { get; set; }
        public string Ciudad { get; set; }
        public string Nivel { get; set; }
        public string Facultad { get; set; }
    }
}